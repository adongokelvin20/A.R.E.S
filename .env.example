# Kevtech Environment Variables

# For Vercel deployment (PostgreSQL):
DATABASE_URL="postgresql://user:password@host:port/dbname?schema=public"

# For local development (SQLite):
# DATABASE_URL="file:./db/custom.db"
# Also change prisma/schema.prisma provider to "sqlite" for local dev

# Your app URL
NEXTAUTH_URL="http://localhost:3000"

# Secret for JWT signing (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="kevtech-secret-7f3a9e2b1c8d4f6a"

# ============================================================
# Meta WhatsApp Cloud API (Embedded Signup)
# ============================================================
# One-time setup by the platform owner (Kevtech Corporation).
# Once configured, customers connect WhatsApp with a single click.
#
# 1. Create a Meta app at https://developers.facebook.com/apps
# 2. Add the WhatsApp product and set up Embedded Signup
# 3. Create an Embedded Signup configuration (gives you CONFIG_ID)
# 4. Set these env vars:
META_APP_ID=""             # numerical App ID from Meta App Dashboard
META_APP_SECRET=""         # App Secret from Settings → Basic
META_CONFIG_ID=""          # Embedded Signup configuration ID
META_VERIFY_TOKEN=""       # any string you choose; used for webhook verification
#
# The webhook URL is automatically: ${NEXTAUTH_URL}/api/ares/whatsapp/webhook
# The Embedded Signup redirect URI is: ${NEXTAUTH_URL}/api/whatsapp/meta/callback
#
# Z.ai API key for the assistant (GLM-4.5-flash, free tier)
ZAI_API_KEY=""

# ============================================================
# Paystack Payment Integration
# ============================================================
# Get these from your Paystack dashboard (https://dashboard.paystack.co)
# The public key is safe to expose; the secret key must stay server-side.
