// A.R.E.S. -- Automated Routing and Execution System
// Multi-tenant AI Business Operating System schema (production-ready)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// CORE TENANT MODEL — every record in the system MUST be scoped
// to a Business. There is NO global data access path.
// ============================================================

model Business {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  type          String   // CLOTHING_STORE | RESTAURANT | SCHOOL | REAL_ESTATE | SERVICE
  industry      String?
  description   String?
  country       String   @default("GH")
  currency      String   @default("GHS")
  timezone      String   @default("Africa/Accra")
  language      String   @default("en")
  phone         String?
  email         String?
  address       String?
  logoUrl       String?
  configuration String   @default("{}")
  enabledModules String  @default("[]")
  plan          String   @default("STARTER")
  status        String   @default("ACTIVE")
  // Hierarchical sector: category (Health, Retail, Food, etc.) + subtype (Clinic, Pharmacy, etc.)
  sectorCategory String?
  sectorSubtype  String?
  // AI personalization
  agentName     String   @default("Kevtech")
  agentPersonality String @default("professional")
  agentInstructions String @default("")
  // AI learning — accumulated facts the AI extracts from conversations
  agentLearnings String   @default("[]")
  ownerFirstName String?
  onboardedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users         User[]
  customers     Customer[]
  products      Product[]
  orders        Order[]
  conversations Conversation[]
  automations   Automation[]
  auditLogs     AuditLog[]
  integrations  Integration[]
  alerts        Alert[]
  insights      Insight[]
  knowledge     KnowledgeEntry[]
}

// ============================================================
// USERS — owners + employees (NextAuth-compatible)
// ============================================================

model User {
  id            String   @id @default(cuid())
  businessId    String
  email         String
  name          String
  passwordHash  String?
  role          String   @default("OWNER")
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  auditLogs     AuditLog[]

  @@unique([businessId, email])
  @@index([businessId])
}

// ============================================================
// CUSTOMERS
// ============================================================

model Customer {
  id            String   @id @default(cuid())
  businessId    String
  name          String?
  phone         String?
  email         String?
  whatsappId    String?
  metadata      String   @default("{}")
  lifetimeValue Float    @default(0)
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business      Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders        Order[]
  conversations Conversation[]

  @@index([businessId, phone])
  @@index([businessId])
}

// ============================================================
// PRODUCTS — image stored as filesystem path under /uploads
// ============================================================

model Product {
  id            String   @id @default(cuid())
  businessId    String
  name          String
  description   String?
  category      String?
  sku           String?
  price         Float
  currency      String   @default("GHS")
  stock         Int      @default(0)
  lowStockThreshold Int  @default(5)
  imageUrl      String?  // URL to serve the image (e.g. /api/image/[id])
  imageData     String?  // base64-encoded image data (stored in DB for Vercel compatibility)
  imageAlt      String?  // AI-visible description of the image for matching
  attributes    String   @default("{}")
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]

  @@index([businessId, sku])
  @@index([businessId])
}

// ============================================================
// ORDERS — with fulfillment type (pickup/delivery) + delivery details
// ============================================================

model Order {
  id            String   @id @default(cuid())
  businessId    String
  customerId    String?
  customerName  String?
  customerPhone String?
  status        String   @default("PENDING")
  channel       String   @default("WHATSAPP")
  total         Float    @default(0)
  currency      String   @default("GHS")
  notes         String?
  // Fulfillment
  fulfillmentType String  @default("PICKUP") // PICKUP | DELIVERY
  deliveryLocation String?
  deliveryTime   String?
  deliveryPhone  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business      Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer      Customer?    @relation(fields: [customerId], references: [id])
  items         OrderItem[]

  @@index([businessId, status])
  @@index([businessId, createdAt])
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  productId     String?
  name          String
  quantity      Int      @default(1)
  unitPrice     Float
  total         Float

  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product? @relation(fields: [productId], references: [id])
}

// ============================================================
// CONVERSATIONS — omnichannel message threads
// ============================================================

model Conversation {
  id            String   @id @default(cuid())
  businessId    String
  customerId    String?
  channel       String   @default("WHATSAPP")
  externalId    String?
  customerName  String?
  customerPhone String?
  status        String   @default("OPEN")
  assigneeId    String?
  summary       String?
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business      Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer      Customer?  @relation(fields: [customerId], references: [id])
  messages      Message[]

  @@index([businessId, status])
  @@index([businessId, channel])
}

model Message {
  id            String   @id @default(cuid())
  conversationId String
  role          String   // CUSTOMER | AI | HUMAN | SYSTEM
  content       String
  // Internal reasoning the AI did (tool lookups, etc.) — never shown to the user
  internalNotes String?
  metadata      String   @default("{}")
  createdAt     DateTime @default(now())

  conversation  Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ============================================================
// AUTOMATION ENGINE
// ============================================================

model Automation {
  id            String   @id @default(cuid())
  businessId    String
  name          String
  description   String?
  trigger       String
  condition     String   @default("{}")
  actions       String   @default("[]")
  status        String   @default("ACTIVE")
  runCount      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
}

// ============================================================
// AI INSIGHTS
// ============================================================

model Insight {
  id            String   @id @default(cuid())
  businessId    String
  severity      String   @default("INFO")
  category      String
  title         String
  body          String
  suggestedActions String @default("[]")
  status        String   @default("OPEN")
  createdAt     DateTime @default(now())

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
}

// ============================================================
// ALERTS
// ============================================================

model Alert {
  id            String   @id @default(cuid())
  businessId    String
  severity      String   @default("ATTENTION")
  source        String
  type          String
  title         String
  message       String
  payload       String   @default("{}")
  status        String   @default("OPEN")
  createdAt     DateTime @default(now())

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id            String   @id @default(cuid())
  businessId    String
  actorId       String?
  actorType     String
  actorName     String?
  action        String
  tool          String?
  target        String?
  result        String
  riskLevel     String   @default("LOW")
  approvalStatus String?
  details       String   @default("{}")
  createdAt     DateTime @default(now())

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actor         User?    @relation(fields: [actorId], references: [id])

  @@index([businessId, createdAt])
}

// ============================================================
// INTEGRATIONS — real credentials stored (encrypted at rest in prod)
// ============================================================

model Integration {
  id            String   @id @default(cuid())
  businessId    String
  type          String   // WHATSAPP_META | WHATSAPP_WAAPI | PAYMENT | EMAIL | SMS
  name          String
  status        String   @default("DISCONNECTED") // CONNECTED | DISCONNECTED | ERROR
  config        String   @default("{}") // non-secret config
  // Secret values — in production these would be encrypted with a per-tenant key.
  // For this deployable build we store them but never expose to the frontend.
  credentials   String   @default("{}") // JSON: { accessToken, phoneNumberId, apiKey, ... } — server-only
  lastSyncAt    DateTime?
  errorCount    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, type])
  @@index([businessId])
}

// ============================================================
// KNOWLEDGE BASE
// ============================================================

model KnowledgeEntry {
  id            String   @id @default(cuid())
  businessId    String
  category      String
  question      String?
  answer        String
  tags          String   @default("[]")
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, category])
}
